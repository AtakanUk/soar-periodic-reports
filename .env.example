# --- IBM QRadar SOAR -----------------------------------------------------
SOAR_HOST=soar.example.com
SOAR_PORT=443
SOAR_ORG=Example Org
SOAR_API_KEY_ID=your-api-key-id
SOAR_API_KEY_SECRET=your-api-key-secret
# CA bundle path, or "false" to skip certificate verification (lab only)
SOAR_CAFILE=

# --- QRadar SIEM (logsource-health only) ---------------------------------
QRADAR_HOST=qradar.example.com
QRADAR_API_TOKEN=your-authorized-service-token
QRADAR_API_VERSION=16.0
QRADAR_VERIFY_SSL=true
QRADAR_CA_BUNDLE=

# --- Mail ------------------------------------------------------------------
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# none | login | oauth2
SMTP_AUTH=oauth2
SMTP_STARTTLS=true
SMTP_USERNAME=soc-notify@example.com
SMTP_PASSWORD=
SMTP_OAUTH_TENANT_ID=your-tenant-id
SMTP_OAUTH_CLIENT_ID=your-app-client-id
SMTP_OAUTH_CLIENT_SECRET=your-app-client-secret
SMTP_OAUTH_REFRESH_TOKEN=your-refresh-token
MAIL_FROM=soc-notify@example.com
MAIL_TO=soc-team@example.com
MAIL_CC=
# Optional per-report recipients (fall back to MAIL_TO / MAIL_CC)
WEEKLY_MAIL_TO=
DAILY_MAIL_TO=
SLA_MAIL_TO=
ALERT_MAIL_TO=

# --- weekly ----------------------------------------------------------------
WEEKLY_DAYS=7
WEEKLY_BASELINE_DAYS=60
WEEKLY_RESOLUTION_METRICS=False-Positive,Action Taken,Known Activity,Non-Issue
WEEKLY_FALSE_POSITIVE_LABEL=False-Positive
WEEKLY_SEVERITIES=Critical
# Name substrings that are not counted as offenses (automation / control incidents)
WEEKLY_OFFENSE_COUNT_EXCLUDE=AUT -,Log Source Check
# "Label=name substring" counters for the automation table, separated by ";"
WEEKLY_NAME_COUNTERS=SIEM rule-based autonomous IP blocking (offenses)=AUT -
WEEKLY_CUSTOMER_RESPONSE_FIELD=customer_response
# Custom incident fields with comma-separated values; leave empty to skip a row
WEEKLY_HONEYPOT_IP_FIELD=honeypot_blocked_ips
WEEKLY_FIREWALL_IP_FIELD=firewall_blocked_ips
WEEKLY_FIREWALL_FLAG_FIELD=firewall_block_requested
WEEKLY_PROXY_DOMAIN_FIELD=proxy_blocked_domains
WEEKLY_MAIL_SUBJECT=Weekly SOC Report

# --- daily-offenses --------------------------------------------------------
DAILY_HOURS=24
DAILY_EXCLUDE_PATTERNS=Log Source Check,AUT -
DAILY_FALLBACK_RULE=Uncategorized

# --- logsource-health --------------------------------------------------------
LOGSOURCE_STALE_HOURS=48
LOGSOURCE_EXCLUDE_NAMES=
# HA members as "first|second" pairs separated by ";"
LOGSOURCE_HA_PAIRS=FW-Cluster @ 192.0.2.5|FW-Cluster @ 192.0.2.6
LOGSOURCE_EXCLUDE_GROUP_IDS=
LOGSOURCE_INCIDENT_NAME=QRadar Log Source ERROR Check
LOGSOURCE_INCIDENT_FIELD=qradar_error_log_sources

# --- sla -----------------------------------------------------------------
SLA_DAYS=7
SLA_THRESHOLD_MINUTES=120
SLA_ANALYST_FIELD=analyst
SLA_REPORTED_FIELD=reported_date
